# Kopo Kopo K2 Connect credentials (server-side only; never use NEXT_PUBLIC_)
KOPOKOPO_BASE_URL=https://sandbox.kopokopo.com
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_API_KEY=
KOPOKOPO_TILL_NUMBER=

# Public HTTPS endpoint that Kopo Kopo calls with the payment result
KOPOKOPO_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/mpesa/callback
NEXT_PUBLIC_APP_URL=https://your-public-domain.example
